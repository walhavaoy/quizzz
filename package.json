{
  "name": "quizzz",
  "version": "0.1.0",
  "description": "Multiplayer real-time trivia quiz game",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json",
    "build:server": "tsc",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pino": "^9.5.0",
    "pino-http": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
